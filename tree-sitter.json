{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hledger_journal",
      "camelcase": "HledgerJournal",
      "title": "hledger journal",
      "scope": "source.hledger_journal",
      "file-types": [
        "journal",
        "j",
        "hledger"
      ],
      "injection-regex": "^hledger(_journal)?$",
      "class-name": "TreeSitterHledgerJournal"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "tree-sitter grammar for hledger journal files",
    "authors": [
      {
        "name": "Tamas Bartfai",
        "email": "tamas@bartfai.dev"
      }
    ],
    "links": {
      "repository": "https://github.com/bartfaitamas/tree-sitter-hledger-journal"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}